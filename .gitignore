# Arquivos temporários e de sistema: não devem subir para o repositório.

# Office (Word, Excel, PowerPoint): arquivo de bloqueio criado enquanto o documento está aberto
~$*
# LibreOffice / OpenOffice: bloqueio
.~lock.*#
# Cópias de recuperação e de segurança do Office
*.tmp
~*.tmp
*.wbk
*.xlk
*.asd
*.bak
# Arquivos que o Office cria ao salvar ou recuperar
~WRL*.tmp
~WRD*.tmp

# Sistema operacional
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Editores
*.swp
*.swo
*~

# Não enviar ao repo
_plan/
_relatorio/

# Python (há scripts na pasta)
__pycache__/
*.pyc
# Automação checklist e extrator: arquivos gerados e segredos
scripts/extrator_scorm/fichas/
scripts/extrator_scorm/controle.json
scripts/extrator_scorm/controle.anterior.json
scripts/extrator_scorm/resumo.json
.env
.venv/
scripts/automacao/relatorios/*.md
scripts/automacao/notion/config.json
.claude/skill/
