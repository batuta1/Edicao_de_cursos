        "type": "list",
        "items": [
          {
            "id": "pjdrku9mzhpqzvg3iva5lmt0",
            "number": "1",
            "paragraph": "<p>Redigir um brief de análise com seis itens.</p>"
          },
          {
            "id": "ef6jegkotm4o3w9ie49ayoio",
            "number": "2",
            "paragraph": "<p>Registrar premissas permanentes em <strong>CLAUDE.md</strong> ou <strong>AGENTS.md</strong>.</p>"
          },
          {
            "id": "ye2aigzj78lavo2skwmmxvy2",
            "number": "3",
            "paragraph": "<p>Exigir o plano antes da execução.</p>"
          },
          {
            "id": "bx78jeepfqwl0kzbdayygj8h",
            "number": "4",
            "paragraph": "<p>Solicitar e ler a explicação do código por blocos.</p>"
          }
        ],
