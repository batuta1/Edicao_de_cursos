        "items": [
          {
            "id": "ybbmj6ib3zi5v7v9nbyyhwj5",
            "paragraph": "<p>Ao final desta lição, você será capaz de:</p>"
          }
        ],
        "family": "text",
        "variant": "paragraph",
        "metadata": {
          "createdVia": "ai",
