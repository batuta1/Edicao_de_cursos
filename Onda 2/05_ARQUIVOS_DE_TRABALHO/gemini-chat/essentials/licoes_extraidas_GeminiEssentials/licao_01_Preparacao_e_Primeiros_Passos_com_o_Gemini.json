            "version": "1.171.1"
          }
        },
        "globalBlockId": "f62e7039-8b7f-40a8-b5de-4f384c491b32"
      },
      {
        "id": "xcgut291hjbjp3r2zp9dpjqu",
        "settings": {},
        "type": "text",
        "items": [
          {
            "id": "s1sxhrawhqw0lbuyy80i20gz",
            "paragraph": "<p>Ao final desta lição, você será capaz de:</p>"
          }
        ],
        "family": "text",
        "variant": "paragraph",
        "metadata": {
          "createdVia": "ai",
          "contentValidation": {
            "pass": true,
            "version": "1.171.1"
