      {
        "id": "c5596cbb-0b4f-47a0-af9b-63887c587949",
        "settings": {},
        "type": "text",
        "items": [
          {
            "id": "f0d1e03a-f489-416c-a4ac-57cc91d50d4c",
            "paragraph": "<p><strong>Checklist de avaliação — confira cada item:</strong></p><ul><li>Pedido com persona, tarefa, contexto e formato.</li><li>Nenhum dado de sinal vermelho.</li><li>Habilidade aplicada no Gemini.</li><li>Uma afirmação de cada ferramenta conferida no Planalto.</li><li>Comparação com preferência justificada.</li></ul>"
          }
        ],
