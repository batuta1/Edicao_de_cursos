          {
            "id": "fft1ek09nzxk2u3tcjb0cs7n",
            "heading": "Onde cada um se apoia",
            "paragraph": "<p>Veja, em cada aba, o ponto forte de cada assistente e o cuidado que ele exige:</p>"
          }
        ],
        "family": "text",
        "variant": "heading paragraph",
