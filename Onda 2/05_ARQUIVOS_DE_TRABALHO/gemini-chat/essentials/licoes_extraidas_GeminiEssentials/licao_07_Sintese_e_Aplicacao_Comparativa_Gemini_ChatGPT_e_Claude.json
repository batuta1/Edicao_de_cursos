      {
        "id": "83f3cfef-07b8-4c5b-a608-55106e6a853c",
        "settings": {},
        "type": "knowledgeCheck",
        "items": [
          {
            "id": "aa8279bb-0e14-430e-afd4-58d661e26685",
            "type": "MULTIPLE_CHOICE",
            "title": "Qual critério deve ser priorizado ao escolher entre Gemini, ChatGPT e Claude para uma tarefa profissional sensível?",
            "answers": [
              {
                "id": "e374572e-1786-455d-8933-5f073c782d02",
                "title": "A ferramenta mais popular no momento.",
                "correct": false,
                "feedback": "Não. Popularidade não diz nada sobre o formato, as fontes ou as regras de dados da sua tarefa."
              },
              {
                "id": "e690a87d-2894-4e5c-9d70-523efcbf8bf1",
                "title": "Aquela que entrega o formato necessário, com fontes conferíveis e dentro das regras de dados aplicáveis.",
                "correct": true,
                "feedback": "Correto. É o critério estável da trilha: formato necessário, fontes conferíveis e regras de dados aplicáveis."
              },
              {
                "id": "14cd5709-ae22-4aee-a745-6ae0d265d0fb",
                "title": "Aquela que responde mais rápido, independentemente da fonte.",
                "correct": false,
                "feedback": "Não. Em tarefa sensível, uma resposta rápida sem fonte conferível só adia o trabalho de verificação."
              },
              {
                "id": "8fde67ad-1333-4f83-b57f-f5fee88ea685",
                "title": "A que oferece mais opções de personalização visual.",
                "correct": false,
                "feedback": "Não. A aparência da interface não influencia a confiabilidade nem a conformidade com as regras de dados."
              }
            ],
            "feedbackType": "CHOICE"
          }
        ],
