      {
        "id": "bg7bt5jmu59b5phz5fi6tgvx",
        "settings": {
          "paddingTop": 0
        },
        "type": "interactive",
        "items": [
          {
            "id": "agphmr1pz9u1e8cg6xpdhr5b",
            "back": {
              "type": "description",
              "description": "<p>A lista de subperguntas e ações que o agente propõe ou executa antes de buscar. Em algumas ferramentas, você pode revisá-lo antes do início.</p>"
            },
            "front": {
              "type": "description",
              "description": "<strong>Plano</strong>"
            }
          },
          {
            "id": "xepx5h8iaf01gsoji9q6idws",
            "back": {
              "type": "description",
              "description": "<p>Ancoragem: a vinculação da resposta a fontes recuperadas. Mostra de onde veio a informação, mas não significa que a inferência esteja correta.</p>"
            },
            "front": {
              "type": "description",
              "description": "<strong>Grounding</strong>"
            }
          },
          {
            "id": "aerolce0r84e7s7i0zdhyogf",
            "back": {
              "type": "description",
              "description": "<p>Citação inline é o marcador junto à afirmação que abre a fonte; sua presença não prova que a fonte sustente a frase.</p>"
            },
            "front": {
              "type": "description",
              "description": "<strong>Citação Inline</strong>"
            }
          },
          {
            "id": "g3h91t5dl6z09iivrrscjhhj",
            "back": {
              "type": "description",
              "description": "<p>O documento ou dado original — lei, decisão, base de dados, relatório do órgão responsável. A fonte secundária apenas interpreta a primária.</p>"
            },
            "front": {
              "type": "description",
              "description": "<strong>Fonte Primária</strong>"
            }
          }
        ],
