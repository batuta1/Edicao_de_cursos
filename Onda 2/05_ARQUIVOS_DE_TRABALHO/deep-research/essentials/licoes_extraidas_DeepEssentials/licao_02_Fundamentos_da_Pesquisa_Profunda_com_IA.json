        "items": [
          {
            "id": "cq2yec1o57nakqo1afu02muf",
            "paragraph": "<p>Ao final desta lição, você será capaz de:</p>"
          }
        ],
        "family": "text",
        "variant": "paragraph",
        "metadata": {
          "createdVia": "ai",
          "contentValidation": {
            "pass": true,
            "version": "1.165.0"
