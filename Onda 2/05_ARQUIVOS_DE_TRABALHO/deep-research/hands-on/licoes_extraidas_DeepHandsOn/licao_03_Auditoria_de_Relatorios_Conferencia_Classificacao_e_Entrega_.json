        "items": [
          {
            "id": "qjcd0ie01jonszjc2a39dfaz",
            "paragraph": "<p>Ao final desta lição, você será capaz de:</p>"
          }
        ],
        "family": "text",
        "variant": "paragraph",
        "metadata": {
          "createdVia": "ai",
          "contentValidation": {
            "pass": true,
            "version": "1.165.0"
