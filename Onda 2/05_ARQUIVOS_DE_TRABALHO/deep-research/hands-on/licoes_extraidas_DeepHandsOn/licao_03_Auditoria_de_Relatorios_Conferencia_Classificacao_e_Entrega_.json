        "items": [
          {
            "id": "s2qin35ygz8egawwl4fmpc1e",
            "back": {
              "type": "description",
              "description": "<p>Fonte oficial que produziu o dado, como IBGE, Banco Central ou Planalto.</p>"
            },
            "front": {
              "type": "description",
              "description": "<strong>Fonte Primária</strong>"
            }
          },
          {
            "id": "jgjrf8yif7kit6hadnm2utw2",
            "back": {
              "type": "description",
              "description": "<p>Fonte que apenas reproduz ou comenta dados, como notícias ou blogs.</p>"
            },
            "front": {
              "type": "description",
              "description": "<strong>Fonte Secundária</strong>"
            }
          },
          {
            "id": "hk5v45ih9tloq75qignfhama",
            "back": {
              "type": "description",
              "description": "<p><strong>Integral</strong> (a fonte diz isso), <strong>parcial</strong> (diz só uma parte, ou mistura cortes), <strong>ausente</strong> (não diz) ou <strong>inacessível</strong> (paywall, link quebrado).</p>"
            },
            "front": {
              "type": "description",
              "description": "<strong>Classificação de Suporte</strong>"
            }
          }
        ],
