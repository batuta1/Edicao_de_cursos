        "items": [
          {
            "id": "a3df4756-92ee-453d-8d14-797e839a87e3",
            "type": "MULTIPLE_CHOICE",
            "title": "Por que é importante conferir pelo menos um número manualmente após a análise automática no ChatGPT?",
            "answers": [
              {
                "id": "d0425966-820a-401d-b058-1e50451de769",
                "title": "A. Para garantir que a IA não cometeu erros na leitura ou cálculo",
                "correct": true,
                "feedback": "Correto. Um número conferido mostra se ele leu as 24 linhas e fez a conta certa."
              },
              {
                "id": "5cce6e63-fe61-4e7f-9ce2-62ddf1eddf95",
                "title": "B. Porque não é necessário confiar na IA",
                "correct": false,
                "feedback": "Não. A IA faz as contas de verdade; a conferência serve para pegar erro de leitura ou de cálculo."
              },
              {
                "id": "6a1ae83a-9367-40ac-8b3f-89515386e5dd",
                "title": "C. Apenas por curiosidade",
                "correct": false,
                "feedback": "Não. É a conferência que permite assinar o relatório."
              },
              {
                "id": "4c393dd2-9ff0-4e1a-9264-1f1fedd340fa",
                "title": "D. Para economizar tempo",
                "correct": false,
                "feedback": "Não. Conferir custa um minuto; o objetivo é a precisão, não a pressa."
              }
            ],
            "feedbackType": "CHOICE"
          }
        ],
