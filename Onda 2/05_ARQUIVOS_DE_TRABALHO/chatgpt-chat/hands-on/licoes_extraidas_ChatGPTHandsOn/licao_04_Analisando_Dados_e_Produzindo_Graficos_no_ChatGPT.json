      {
        "id": "eubs1j3sivmlmo42eftw7ill",
        "settings": {
          "paddingTop": 0
        },
        "type": "list",
        "items": [
          {
            "id": "i8t0qowjwinr1py2dzgoatix",
            "number": "1",
            "paragraph": "<p>Conferir se o ChatGPT leu a planilha certa antes de analisar.</p>"
          },
          {
            "id": "d0v91jnch303vpe0mgdeytim",
            "number": "2",
            "paragraph": "<p>Obter totais, taxas e uma tabela por categoria.</p>"
          },
          {
            "id": "n9wqcgahg6hjha01rehtqtgp",
            "number": "3",
            "paragraph": "<p>Gerar e baixar um gráfico de tendência.</p>"
          },
          {
            "id": "brm1x9cqqyw37hb0j69okqr2",
            "number": "4",
            "paragraph": "<p>Conferir à mão pelo menos um número.</p>"
          }
        ],
        "family": "list",
        "variant": "numbered",
        "metadata": {
          "createdVia": "ai",
          "contentValidation": {
            "pass": true,
            "version": "1.171.1"
