      {
        "id": "gch46avphs8xscamgl0ou3hm",
        "settings": {
          "paddingTop": 0
        },
        "type": "list",
        "items": [
          {
            "id": "x7mnb9e35nbk1yh22p9h93hh",
            "number": "1",
            "paragraph": "<p>Extrair do documento uma tabela de prazos com o item de origem.</p>"
          },
          {
            "id": "fvyc9eaq4rz1axwjrr7enw9p",
            "number": "2",
            "paragraph": "<p>Conferir a tabela contra o arquivo original.</p>"
          },
          {
            "id": "hviouhw9ohl54hz577ods1t1",
            "number": "3",
            "paragraph": "<p>Reconhecer e desmontar uma resposta inventada.</p>"
          },
          {
            "id": "j3khq8fg1l1diyy8kepk2hqt",
            "number": "4",
            "paragraph": "<p>Resumir o documento para quem nunca o leu.</p>"
          }
        ],
        "family": "list",
        "variant": "numbered",
        "metadata": {
          "createdVia": "ai",
