        "items": [
          {
            "id": "o6nz1tlvjnwkhdbp44gmhhgb",
            "paragraph": "<p>🧰 <strong>O que você vai usar:</strong> o projeto <strong>Caso Loja Aurora</strong>, com a política anexada na Oficina 1.</p>"
          }
        ],
        "family": "text",
