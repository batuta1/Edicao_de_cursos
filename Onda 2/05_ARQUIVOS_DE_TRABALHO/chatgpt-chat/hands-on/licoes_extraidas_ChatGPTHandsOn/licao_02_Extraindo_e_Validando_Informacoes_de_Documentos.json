      {
        "id": "ecc2c872-6c97-482e-8ce1-5629c7ab3967",
        "settings": {},
        "type": "knowledgeCheck",
        "items": [
          {
            "id": "7ae58935-3932-4f4d-8859-ed7c22ec8ad8",
            "type": "MULTIPLE_CHOICE",
            "title": "A política da Loja Aurora não fala em multa por atraso na entrega. O que o ChatGPT deve responder à pergunta do passo 3?",
            "answers": [
              {
                "id": "f1349b66-250d-4267-ae45-b267592fc1be",
                "title": "A) Inventar um valor aproximado de multa",
                "correct": false,
                "feedback": "Não. Valor sem base no documento é invenção."
              },
              {
                "id": "cbe3791b-149a-4cff-9891-5c5255a06eb0",
                "title": "B) Dizer que não consta nos arquivos",
                "correct": true,
                "feedback": "Correto. É o que as instruções do projeto pedem: se não está nos arquivos, “não consta nos arquivos”."
              },
              {
                "id": "0fac74df-d27b-4e0b-a30f-fe7c610ff931",
                "title": "C) Sugerir uma multa baseada em outras lojas",
                "correct": false,
                "feedback": "Não. Prática de outras lojas não é regra da Loja Aurora."
              },
              {
                "id": "1f9ecea9-9733-46d1-86ea-9f0ee2bd9a0a",
                "title": "D) Ignorar a pergunta e mudar de assunto",
                "correct": false,
                "feedback": "Não. A resposta certa existe: dizer que a informação não consta."
              }
            ],
            "feedbackType": "CHOICE"
          }
        ],
