      {
        "id": "af1dea1b-496e-482d-bdfd-2bc5bfa9a1ed",
        "settings": {},
        "type": "knowledgeCheck",
        "items": [
          {
            "id": "59b8aede-1afb-4953-8e55-eaeae7202c69",
            "type": "MULTIPLE_CHOICE",
            "title": "Após pedir ao ChatGPT uma comparação da política com o CDC, qual é a forma correta de validar a resposta?",
            "answers": [
              {
                "id": "1a57886a-b574-4b2f-9818-bd31e5352740",
                "title": "Aceitar o link da resposta como prova",
                "correct": false,
                "feedback": "Não. Link na resposta não é prova: o link pode não dizer o que a frase afirma."
              },
              {
                "id": "074ed13b-a157-4533-b704-de1e263c2fbc",
                "title": "Ler o artigo citado diretamente no site oficial antes de concluir",
                "correct": true,
                "feedback": "Correto. Prova é o trecho que você leu na página oficial."
              },
              {
                "id": "d7db6fce-8013-498d-b266-6ff8392b3c4b",
                "title": "Confiar na resposta da IA sem checar",
                "correct": false,
                "feedback": "Não. O assistente pode citar o artigo errado ou dizer que 45 dias está de acordo."
              },
              {
                "id": "00bc8cfc-e5e7-4347-8fc7-ed43f725eca1",
                "title": "Usar apenas o resumo do ChatGPT",
                "correct": false,
                "feedback": "Não. Resumo da IA não substitui a leitura do artigo no Planalto."
              }
            ],
            "feedbackType": "CHOICE"
          }
        ],
        "family": "knowledgeCheck",
